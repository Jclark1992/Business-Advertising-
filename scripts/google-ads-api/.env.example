# Copy this file to `.env` in the SAME folder and fill in real values.
# `.env` is git-ignored (see repo root .gitignore) — it must never be
# committed. Do not paste real values into this .example file either.

# From Google Ads > Tools & Settings > Setup > API Center. This is the
# credential you already have. Server-side only — never in website code.
GOOGLE_ADS_DEVELOPER_TOKEN=

# From Google Cloud Console > APIs & Services > Credentials
# (OAuth 2.0 Client ID, type "Desktop app"). See ../README.md step 1.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Generated once by running get_refresh_token.py — see ../README.md step 2.
GOOGLE_ADS_REFRESH_TOKEN=

# The Google Ads account these scripts read from, digits only, no dashes
# (e.g. 1234567890). Find it top-right of the Google Ads UI.
GOOGLE_ADS_CUSTOMER_ID=

# Only needed if GOOGLE_ADS_CUSTOMER_ID is managed under an MCC/manager
# account — set to the MANAGER account's ID (digits only). Leave blank for
# a standalone account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
